{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node bin/agentbridge-claude-guard.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/claude-stop-gate.mjs",
            "timeout": 190
          }
        ]
      }
    ]
  },
  "disableAllHooks": false
}
